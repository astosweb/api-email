{
  "name": "api-email",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade developer email API and self-hosted email infrastructure",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "generate": "pnpm --filter @api-email/api exec prisma generate",
    "db:push": "pnpm --filter @api-email/api exec prisma db push"
  }
}
