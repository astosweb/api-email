# Domain (non-secret)
DOMAIN=example.com
API_DOMAIN=api.example.com
WEB_DOMAIN=app.example.com
SMTP_HOSTNAME=smtp.example.com
ADMIN_EMAIL=admin@example.com

# Database (generated on install)
POSTGRES_USER=apiemail
POSTGRES_PASSWORD=
POSTGRES_DB=apiemail
DATABASE_URL=

# Redis (generated on install)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Application secrets (generated on install)
JWT_SECRET=
API_KEY_SECRET=
WEBHOOK_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_TOKEN=

# SMTP (Postfix on host)
SMTP_HOST=host.docker.internal
SMTP_PORT=25

# Public URLs
API_PUBLIC_URL=https://api.example.com
WEB_PUBLIC_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# Worker
WORKER_REPLICAS=1
WORKER_CONCURRENCY=10
